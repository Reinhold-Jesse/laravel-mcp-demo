{
    "name": "laravel-mcp-demo/menu-builder",
    "description": "Reusable Filament menu builder for Laravel applications.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.6",
        "laravel/framework": "^13.0",
        "livewire/livewire": "^4.3"
    },
    "autoload": {
        "psr-4": {
            "LaravelMcpDemo\\MenuBuilder\\": "src/",
            "LaravelMcpDemo\\MenuBuilder\\Database\\Factories\\": "database/factories/",
            "LaravelMcpDemo\\MenuBuilder\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelMcpDemo\\MenuBuilder\\MenuBuilderServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
